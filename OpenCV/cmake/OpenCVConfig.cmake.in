# OpenCV CMake configuration file
# This file is generated by the build system

set(OpenCV_VERSION "@OPENCV_VERSION@")
set(OpenCV_VERSION_MAJOR "@OPENCV_VERSION_MAJOR@")
set(OpenCV_VERSION_MINOR "@OPENCV_VERSION_MINOR@")
set(OpenCV_VERSION_PATCH "@OPENCV_VERSION_PATCH@")

set(OpenCV_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include")

set(OpenCV_LIBS opencv_world)

# Include the targets file
include("@CMAKE_INSTALL_PREFIX@/cmake/OpenCVTargets.cmake")

# Set OpenCV_DIR for find_package
set(OpenCV_DIR "@CMAKE_INSTALL_PREFIX@/cmake")
