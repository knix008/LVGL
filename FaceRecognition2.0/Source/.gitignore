# Temporary files
*.tmp
*.temp
*.cache

# Downloaded source archives (these are downloaded during build)
*.tar.gz
*.tar.xz
*.zip

# Downloaded source directories (these are extracted during build)
zlib-*/
xz-*/
ffmpeg-*/

# ONNX Runtime files (these are downloaded separately)
onnxruntime/

# Model files (these can be large)
models/*.onnx
models/*.pt

# Audio/Video files (these can be large)
assets/*.mp4
assets/*.wav
assets/*.avi
assets/*.mov

# Keep some essential assets
!assets/*.png
!assets/*.jpg
!assets/*.jpeg
!assets/*.gif
!assets/*.svg
!assets/*.ttf

# Python cache files
