# Build artifacts
build/
*.o
*.a
*.so
*.exe
main
webcam_ipc_app

# CMake generated files
CMakeCache.txt
cmake_install.cmake
CMakeFiles/
Makefile
*.cmake

# Pre-built libraries (these are built from source)
lib/

