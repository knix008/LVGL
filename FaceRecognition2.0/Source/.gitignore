*.pyc
*.pyo
*.pyd
.Python

# Jupyter Notebook
.ipynb_checkpoints

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup files
*.backup
*.old
*.orig

# Core dumps
core
core.*

# IPC socket files
/tmp/opencv_gui_socket
*.socket

# Database files (if any are created)
*.db
*.sqlite
*.sqlite3
